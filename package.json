{
  "name": "cheapseggs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev --local --port 8787",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:db": "node --experimental-strip-types scripts/check-migrations.ts",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file seeds/local.sql",
    "db:check": "wrangler d1 execute DB --local --command 'PRAGMA foreign_key_check; SELECT count(*) AS sample_activities FROM activity_versions;'",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build"
  },
  "dependencies": {
    "hono": "4.13.19",
    "preact": "11.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "5.20261119.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
