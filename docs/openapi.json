{
  "openapi": "3.1.0",
  "info": {
    "title": "CheapSeggs public, guest and account API",
    "version": "0.3.0",
    "description": "Implemented public/guest routes and reviewed M3A email-code account lifecycle. Real age assurance, restricted content, private matching and payments remain unavailable."
  },
  "servers": [
    {
      "url": "https://cheapseggs.com"
    },
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "service", "stage"],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "cheapseggs"
                    },
                    "stage": {
                      "const": "foundation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Migrated D1 catalog queryable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or not migrated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "const": "unavailable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/preview": {
      "get": {
        "operationId": "publicCatalogPreview",
        "responses": {
          "200": {
            "description": "Designated non-intimate free previews only",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "catalogVersion"],
                  "properties": {
                    "catalogVersion": {
                      "const": "sample-1"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "version", "title", "description", "durationMinutes"],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "version": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "durationMinutes": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Generic request failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wheels/misfortune": {
      "get": {
        "operationId": "wheelConfig",
        "summary": "Published wheel configuration and catalog counts",
        "responses": {
          "200": {
            "description": "Wheel configuration with no visitor data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Approximate per-location rate limit exceeded (rate_limited)",
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds until the window resets"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spins": {
      "post": {
        "operationId": "spin",
        "summary": "Guest Discovery spin (server-side eligibility and authoritative result)",
        "parameters": [
          {
            "name": "x-cheapseggs-guest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "wheelId",
                  "heat",
                  "experimentation",
                  "energy",
                  "duration",
                  "environment",
                  "supplies",
                  "optIns",
                  "excludedCategories",
                  "excludedActivities",
                  "repeatPolicy",
                  "idempotencyKey"
                ],
                "properties": {
                  "wheelId": {
                    "const": "misfortune"
                  },
                  "heat": {
                    "enum": ["mild", "medium", "spicy", "habanero"]
                  },
                  "experimentation": {
                    "enum": ["classic", "curious", "adventurous"]
                  },
                  "energy": {
                    "enum": ["low", "moderate", "high"]
                  },
                  "duration": {
                    "enum": ["quickie", "30-minutes", "hour", "all-evening"]
                  },
                  "environment": {
                    "enum": ["home", "hotel", "getaway", "private-other"]
                  },
                  "supplies": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "maxLength": 40
                    }
                  },
                  "optIns": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "maxLength": 40
                    }
                  },
                  "excludedCategories": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "maxLength": 40
                    }
                  },
                  "excludedActivities": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "maxLength": 60
                    }
                  },
                  "repeatPolicy": {
                    "enum": ["allow", "avoid-recent"]
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative result or an explained empty pool",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "enum": ["result", "empty"]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed guest nonce",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-site request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict or invalidated result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Guest spin budget exhausted (guest_budget_exhausted) or the approximate per-location Cloudflare rate limit was exceeded (rate_limited, with a retry-after header)",
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "string"
                },
                "description": "Present for rate_limited; seconds until the window resets"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable, or the required fingerprint key is missing or invalid (fail closed: nothing is persisted and no configuration is echoed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "operationId": "version",
        "summary": "Release identity and non-secret configuration health flags",
        "responses": {
          "200": {
            "description": "Release identity plus spinDigestKeyed and rateLimits health flags",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "service",
                    "revision",
                    "workerVersion",
                    "environment",
                    "spinDigestKeyed",
                    "rateLimits"
                  ],
                  "properties": {
                    "service": {
                      "const": "cheapseggs"
                    },
                    "revision": {
                      "type": "string"
                    },
                    "workerVersion": {
                      "type": ["string", "null"]
                    },
                    "environment": {
                      "type": "string"
                    },
                    "spinDigestKeyed": {
                      "type": "boolean",
                      "description": "A valid HMAC key is configured, so the spin endpoint will not fail closed"
                    },
                    "rateLimits": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["spin", "wheel"],
                      "properties": {
                        "spin": {
                          "type": "boolean"
                        },
                        "wheel": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/guest": {
      "delete": {
        "operationId": "resetGuest",
        "summary": "Delete the presenting guest session and its spins",
        "parameters": [
          {
            "name": "x-cheapseggs-guest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session deleted (or nothing to delete)"
          }
        }
      }
    },
    "/api/account/status": {
      "get": {
        "summary": "Email sign-in availability; ageVerificationAvailable and restrictedContentAvailable remain false",
        "responses": {
          "200": {
            "description": "Email sign-in availability; ageVerificationAvailable and restrictedContentAvailable remain false"
          },
          "401": {
            "description": "No valid session"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        }
      }
    },
    "/api/account": {
      "get": {
        "summary": "Current verified-inbox identity, adult declaration and own preview category approvals",
        "responses": {
          "200": {
            "description": "Current verified-inbox identity, adult declaration and own preview category approvals"
          },
          "401": {
            "description": "No valid session"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        }
      }
    },
    "/api/account/sessions": {
      "get": {
        "summary": "Own session IDs/times, never bearer tokens",
        "responses": {
          "200": {
            "description": "Own session IDs/times, never bearer tokens"
          },
          "401": {
            "description": "No valid session"
          },
          "503": {
            "description": "Not configured or unavailable"
          }
        }
      }
    },
    "/api/auth/email-otp/send-verification-otp": {
      "post": {
        "description": "Same-origin JSON only; exact Origin, same-origin Fetch Metadata when present and X-CheapSeggs-Action: account required. 4 KiB limit. Owner-scoped sessions; deletion requires authentication within five minutes. No bearer token in returned JSON.",
        "parameters": [
          {
            "in": "header",
            "name": "X-CheapSeggs-Action",
            "required": true,
            "schema": {
              "const": "account"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "adult": {
                    "const": true
                  }
                },
                "required": ["email", "adult"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation completed"
          },
          "400": {
            "description": "Invalid request or code"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Request denied or fresh sign in required"
          },
          "413": {
            "description": "Body too large"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/api/auth/sign-in/email-otp": {
      "post": {
        "description": "Same-origin JSON only; exact Origin, same-origin Fetch Metadata when present and X-CheapSeggs-Action: account required. 4 KiB limit. Owner-scoped sessions; deletion requires authentication within five minutes. No bearer token in returned JSON.",
        "parameters": [
          {
            "in": "header",
            "name": "X-CheapSeggs-Action",
            "required": true,
            "schema": {
              "const": "account"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "adult": {
                    "const": true
                  },
                  "otp": {
                    "type": "string",
                    "pattern": "^[0-9]{8}$"
                  },
                  "recovery": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": ["email", "adult", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation completed"
          },
          "400": {
            "description": "Invalid request or code"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Request denied or fresh sign in required"
          },
          "413": {
            "description": "Body too large"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "description": "Same-origin JSON only; exact Origin, same-origin Fetch Metadata when present and X-CheapSeggs-Action: account required. 4 KiB limit. Owner-scoped sessions; deletion requires authentication within five minutes. No bearer token in returned JSON.",
        "parameters": [
          {
            "in": "header",
